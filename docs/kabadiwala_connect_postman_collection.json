    {
      "name": "3. Citizen Portal Workflows",
      "item": [
        {
          "name": "Create Pickup Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{citizenToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"A-42, Defence Colony, New Delhi\",\n  \"latitude\": 28.5720,\n  \"longitude\": 77.2310,\n  \"scheduledAt\": \"2026-09-08T10:00:00.000Z\",\n  \"notes\": \"Old newspaper stacks and cardboard delivery cartons\",\n  \"items\": [\n    {\n      \"category\": \"Paper\",\n      \"estWeightKg\": 25.0,\n      \"ratePerKg\": 14.0\n    },\n    {\n      \"category\": \"Plastic\",\n      \"estWeightKg\": 6.0,\n      \"ratePerKg\": 18.0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pickups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pickups"]
            }
          }
        },
        {
          "name": "Get Citizen's Pickups",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{citizenToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pickups/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pickups", "my"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Kabadiwala Portal Workflows",
      "item": [
        {
          "name": "Get Nearby Open Requests (Haversine Geo Filter)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{kabadiwalaToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pickups/nearby?lat=28.5700&lng=77.2400&radius=15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pickups", "nearby"],
              "query": [
                { "key": "lat", "value": "28.5700" },
                { "key": "lng", "value": "77.2400" },
                { "key": "radius", "value": "15" }
              ]
            }
          }
        },
        {
          "name": "Accept Pickup Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{kabadiwalaToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pickups/:pickupId/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pickups", ":pickupId", "accept"],
              "variable": [
                { "key": "pickupId", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Complete Pickup with Verified Scale Weights",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{kabadiwalaToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"category\": \"Plastic\", \"weightKg\": 14.5 },\n    { \"category\": \"Paper\", \"weightKg\": 8.0 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pickups/:pickupId/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pickups", ":pickupId", "complete"],
              "variable": [
                { "key": "pickupId", "value": "" }
              ]
            }
          }
        },
